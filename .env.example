# Backend Mode: gas | postgres | dual_write
VITE_BACKEND_MODE=dual_write

# Google Apps Script Web App URL (required for reporting/sheets sync)
VITE_GAS_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Supabase PostgreSQL Database (required for dual_write / postgres mode)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Cloudflare R2 Image Worker URL (optional)
VITE_R2_URL=

# App Configuration (optional)
VITE_APP_TITLE=KING's GRILL Manager AI v2.0

